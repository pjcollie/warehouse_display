import tkinter as tk
from tkinter import ttk
import requests
from datetime import datetime

API_URL = "http://127.0.0.1:5000/data"
REFRESH_MS = 5000

PRIORITY_COLORS = {
    "Critical": "#e74c3c",
    "High": "#e67e22",
    "Medium": "#f1c40f",
    "Normal": "#2ecc71"
}

class WarehouseDisplay(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Warehouse Display")
        self.configure(bg="#1a1a1a")
        self.attributes("-fullscreen", True)
        self.bind("<Escape>", lambda e: self.destroy())

        # Top bar - Time & Date
        self.top_frame = tk.Frame(self, bg="#111111", height=90)
        self.top_frame.pack(fill="x")
        self.top_frame.pack_propagate(False)

        self.date_label = tk.Label(
            self.top_frame, text="", font=("Segoe UI", 28, "bold"),
            fg="#ecf0f1", bg="#111111"
        )
        self.date_label.pack(side="left", padx=40, pady=20)

        self.time_label = tk.Label(
            self.top_frame, text="", font=("Segoe UI", 36, "bold"),
            fg="#ffffff", bg="#111111"
        )
        self.time_label.pack(side="right", padx=40, pady=15)

        # Days without mistake
        self.days_frame = tk.Frame(self, bg="#1a1a1a")
        self.days_frame.pack(fill="x", pady=(30, 10))

        self.days_label = tk.Label(
            self.days_frame, text="0", font=("Segoe UI", 72, "bold"),
            fg="#2ecc71", bg="#1a1a1a"
        )
        self.days_label.pack()

        self.days_text = tk.Label(
            self.days_frame, text="DAYS WITHOUT A MISTAKE",
            font=("Segoe UI", 22), fg="#bdc3c7", bg="#1a1a1a"
        )
        self.days_text.pack()

        # Hot List header
        self.list_header = tk.Label(
            self, text="HOT LIST", font=("Segoe UI", 20, "bold"),
            fg="#ecf0f1", bg="#1a1a1a", anchor="w"
        )
        self.list_header.pack(fill="x", padx=40, pady=(25, 5))

        # Scrollable hot list
        self.canvas = tk.Canvas(self, bg="#1a1a1a", highlightthickness=0)
        self.scrollbar = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview)
        self.list_frame = tk.Frame(self.canvas, bg="#1a1a1a")

        self.list_frame.bind(
            "<Configure>",
            lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all"))
        )

        self.canvas.create_window((0, 0), window=self.list_frame, anchor="nw")
        self.canvas.configure(yscrollcommand=self.scrollbar.set)

        self.canvas.pack(side="left", fill="both", expand=True, padx=(40, 0), pady=10)
        self.scrollbar.pack(side="right", fill="y", padx=(0, 20), pady=10)

        self.update_clock()
        self.refresh_data()

    def update_clock(self):
        now = datetime.now()
        self.date_label.config(text=now.strftime("%A, %B %d, %Y").upper())
        self.time_label.config(text=now.strftime("%I:%M %p"))
        self.after(1000, self.update_clock)

    def clear_list(self):
        for widget in self.list_frame.winfo_children():
            widget.destroy()

    def add_item_row(self, item):
        priority = item.get("priority", "Normal")
        color = PRIORITY_COLORS.get(priority, "#2ecc71")

        row = tk.Frame(self.list_frame, bg="#2c2c2c", height=70)
        row.pack(fill="x", pady=6, padx=5)
        row.pack_propagate(False)

        bar = tk.Frame(row, bg=color, width=8)
        bar.pack(side="left", fill="y")

        content = tk.Frame(row, bg="#2c2c2c")
        content.pack(side="left", fill="both", expand=True, padx=15, pady=8)

        top_line = tk.Frame(content, bg="#2c2c2c")
        top_line.pack(fill="x")

        tk.Label(
            top_line, text=f"#{item.get('order_number', '')}",
            font=("Segoe UI", 16, "bold"), fg="#ffffff", bg="#2c2c2c"
        ).pack(side="left")

        tk.Label(
            top_line, text=item.get("location", ""),
            font=("Segoe UI", 14), fg="#bdc3c7", bg="#2c2c2c"
        ).pack(side="right")

        tk.Label(
            content, text=item.get("description", ""),
            font=("Segoe UI", 15), fg="#ecf0f1", bg="#2c2c2c", anchor="w"
        ).pack(fill="x", pady=(2, 0))

    def refresh_data(self):
        try:
            r = requests.get(API_URL, timeout=2)
            data = r.json()

            self.days_label.config(text=str(data.get("days_without_mistake", 0)))

            self.clear_list()
            for item in data.get("hot_list", []):
                self.add_item_row(item)

        except Exception as e:
            print("Refresh error:", e)

        self.after(REFRESH_MS, self.refresh_data)

if __name__ == "__main__":
    app = WarehouseDisplay()
    app.mainloop()
