import tkinter as tk
from tkinter import ttk, messagebox, simpledialog
import requests
import threading

# Your Raspberry Pi IP
PI_IP = "10.50.154.254"

PRIORITY_COLORS = {
    "Critical": "#e74c3c",
    "High": "#e67e22",
    "Medium": "#f1c40f",
    "Normal": "#2ecc71"
}

class ControlApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Warehouse Control")
        self.geometry("920x680")
        self.configure(bg="#f0f0f0")
        self.auto_refresh = tk.BooleanVar(value=True)
        self._refresh_job = None

        # ---------- Connection bar ----------
        conn_frame = tk.Frame(self, bg="#f0f0f0")
        conn_frame.pack(fill="x", padx=15, pady=10)

        tk.Label(conn_frame, text="Pi IP:", bg="#f0f0f0").pack(side="left")
        self.ip_entry = tk.Entry(conn_frame, width=18)
        self.ip_entry.insert(0, PI_IP)
        self.ip_entry.pack(side="left", padx=5)

        tk.Button(conn_frame, text="Connect / Refresh", command=self.refresh).pack(side="left", padx=5)

        self.status_label = tk.Label(conn_frame, text="● Disconnected", fg="#c0392b", bg="#f0f0f0", font=("Segoe UI", 10, "bold"))
        self.status_label.pack(side="left", padx=15)

        tk.Checkbutton(conn_frame, text="Auto-refresh", variable=self.auto_refresh,
                       command=self._toggle_auto_refresh, bg="#f0f0f0").pack(side="right")

        # ---------- Days Without a Mistake ----------
        days_frame = tk.LabelFrame(self, text="Days Without a Mistake", padx=10, pady=10)
        days_frame.pack(fill="x", padx=15, pady=5)

        self.days_var = tk.StringVar(value="0")
        tk.Label(days_frame, textvariable=self.days_var, font=("Segoe UI", 28, "bold")).pack(side="left")

        tk.Button(days_frame, text="Set to 0", command=lambda: self.set_days(0)).pack(side="right", padx=5)
        self.new_days = tk.Entry(days_frame, width=6)
        self.new_days.pack(side="right")
        tk.Button(days_frame, text="Set Value", command=self.set_custom_days).pack(side="right", padx=5)

        # ---------- Add Hot List Item ----------
        add_frame = tk.LabelFrame(self, text="Add Hot List Item", padx=10, pady=10)
        add_frame.pack(fill="x", padx=15, pady=5)

        form = tk.Frame(add_frame)
        form.pack(fill="x")

        tk.Label(form, text="Order #").grid(row=0, column=0, sticky="w")
        self.order_entry = tk.Entry(form, width=12)
        self.order_entry.grid(row=0, column=1, padx=5, pady=2)

        tk.Label(form, text="Location").grid(row=0, column=2, sticky="w")
        self.loc_entry = tk.Entry(form, width=12)
        self.loc_entry.grid(row=0, column=3, padx=5, pady=2)

        tk.Label(form, text="Priority").grid(row=0, column=4, sticky="w")
        self.priority = ttk.Combobox(form, values=["Critical", "High", "Medium", "Normal"],
                                     width=10, state="readonly")
        self.priority.set("Normal")
        self.priority.grid(row=0, column=5, padx=5, pady=2)

        tk.Label(form, text="Status").grid(row=0, column=6, sticky="w")
        self.status = ttk.Combobox(form, values=["Open", "Complete"], width=10, state="readonly")
        self.status.set("Open")
        self.status.grid(row=0, column=7, padx=5, pady=2)

        tk.Label(form, text="Description").grid(row=1, column=0, sticky="w", pady=(6, 0))
        self.desc_entry = tk.Entry(form, width=80)
        self.desc_entry.grid(row=1, column=1, columnspan=7, sticky="ew", padx=5, pady=(6, 0))

        # Bind Enter key to add
        for widget in (self.order_entry, self.loc_entry, self.desc_entry):
            widget.bind("<Return>", lambda e: self.add_item())

        tk.Button(add_frame, text="Add to Hot List", command=self.add_item,
                  bg="#27ae60", fg="white").pack(pady=8)

        # ---------- Current Hot List ----------
        list_frame = tk.LabelFrame(self, text="Current Hot List  (double-click to edit)", padx=10, pady=10)
        list_frame.pack(fill="both", expand=True, padx=15, pady=5)

        columns = ("order", "desc", "loc", "pri", "status")
        self.tree = ttk.Treeview(list_frame, columns=columns, show="headings", height=14)

        self.tree.heading("order", text="Order #")
        self.tree.heading("desc", text="Description")
        self.tree.heading("loc", text="Location")
        self.tree.heading("pri", text="Priority")
        self.tree.heading("status", text="Status")

        self.tree.column("order", width=90, anchor="center")
        self.tree.column("desc", width=360)
        self.tree.column("loc", width=100, anchor="center")
        self.tree.column("pri", width=90, anchor="center")
        self.tree.column("status", width=90, anchor="center")

        self.tree.pack(side="left", fill="both", expand=True)

        scrollbar = ttk.Scrollbar(list_frame, orient="vertical", command=self.tree.yview)
        scrollbar.pack(side="right", fill="y")
        self.tree.configure(yscrollcommand=scrollbar.set)

        # Color tags
        self.tree.tag_configure("Critical", foreground="#e74c3c")
        self.tree.tag_configure("High", foreground="#e67e22")
        self.tree.tag_configure("Medium", foreground="#d4ac0d")
        self.tree.tag_configure("Normal", foreground="#27ae60")
        self.tree.tag_configure("Complete", foreground="#7f8c8d")

        self.tree.bind("<Double-1>", self.edit_item)
        self.tree.bind("<Delete>", lambda e: self.delete_item())

        tk.Button(self, text="Delete Selected", command=self.delete_item,
                  bg="#c0392b", fg="white").pack(pady=8)

        self.refresh()
        self._toggle_auto_refresh()

    # ------------------------------------------------------------------
    def get_base(self):
        ip = self.ip_entry.get().strip()
        return f"http://{ip}:5000"

    def set_connected(self, connected: bool):
        if connected:
            self.status_label.config(text="● Connected", fg="#27ae60")
        else:
            self.status_label.config(text="● Disconnected", fg="#c0392b")

    def refresh(self):
        try:
            r = requests.get(f"{self.get_base()}/data", timeout=3)
            data = r.json()
            self.set_connected(True)

            self.days_var.set(str(data.get("days_without_mistake", 0)))

            for row in self.tree.get_children():
                self.tree.delete(row)

            for item in data.get("hot_list", []):
                pri = item.get("priority", "Normal")
                status = item.get("status", "Open")
                tags = [pri]
                if status == "Complete":
                    tags.append("Complete")

                self.tree.insert("", "end", iid=item["id"], values=(
                    item.get("order_number", ""),
                    item.get("description", ""),
                    item.get("location", ""),
                    pri,
                    status
                ), tags=tags)

        except Exception as e:
            self.set_connected(False)
            # Only show popup on manual refresh, not on auto
            if not self.auto_refresh.get():
                messagebox.showerror("Connection Error", f"Could not reach Pi.\n{e}")

    def _toggle_auto_refresh(self):
        if self._refresh_job:
            self.after_cancel(self._refresh_job)
            self._refresh_job = None
        if self.auto_refresh.get():
            self._schedule_refresh()

    def _schedule_refresh(self):
        self.refresh()
        if self.auto_refresh.get():
            self._refresh_job = self.after(12000, self._schedule_refresh)

    # ------------------------------------------------------------------
    def add_item(self):
        item = {
            "order_number": self.order_entry.get().strip(),
            "description": self.desc_entry.get().strip(),
            "location": self.loc_entry.get().strip(),
            "priority": self.priority.get(),
            "status": self.status.get()
        }
        if not item["order_number"] or not item["description"]:
            messagebox.showwarning("Missing Info", "Order # and Description are required.")
            return
        try:
            requests.post(f"{self.get_base()}/hotlist", json=item, timeout=3)
            self.order_entry.delete(0, tk.END)
            self.desc_entry.delete(0, tk.END)
            self.loc_entry.delete(0, tk.END)
            self.status.set("Open")
            self.priority.set("Normal")
            self.refresh()
            self.order_entry.focus()
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def delete_item(self):
        selected = self.tree.selection()
        if not selected:
            return
        if not messagebox.askyesno("Confirm Delete", "Delete the selected item?"):
            return
        item_id = selected[0]
        try:
            requests.delete(f"{self.get_base()}/hotlist/{item_id}", timeout=3)
            self.refresh()
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def edit_item(self, event):
        selected = self.tree.selection()
        if not selected:
            return
        item_id = selected[0]
        values = self.tree.item(item_id, "values")

        # Simple edit dialog
        dialog = tk.Toplevel(self)
        dialog.title("Edit Item")
        dialog.geometry("520x260")
        dialog.transient(self)
        dialog.grab_set()

        fields = {}
        labels = ["Order #", "Description", "Location", "Priority", "Status"]
        defaults = list(values)

        for i, (lab, val) in enumerate(zip(labels, defaults)):
            tk.Label(dialog, text=lab).grid(row=i, column=0, sticky="w", padx=10, pady=6)
            if lab == "Priority":
                cb = ttk.Combobox(dialog, values=["Critical", "High", "Medium", "Normal"], state="readonly", width=40)
                cb.set(val)
                cb.grid(row=i, column=1, padx=10, pady=6)
                fields[lab] = cb
            elif lab == "Status":
                cb = ttk.Combobox(dialog, values=["Open", "Complete"], state="readonly", width=40)
                cb.set(val)
                cb.grid(row=i, column=1, padx=10, pady=6)
                fields[lab] = cb
            else:
                e = tk.Entry(dialog, width=42)
                e.insert(0, val)
                e.grid(row=i, column=1, padx=10, pady=6)
                fields[lab] = e

        def save():
            updated = {
                "order_number": fields["Order #"].get().strip(),
                "description": fields["Description"].get().strip(),
                "location": fields["Location"].get().strip(),
                "priority": fields["Priority"].get(),
                "status": fields["Status"].get()
            }
            if not updated["order_number"] or not updated["description"]:
                messagebox.showwarning("Missing Info", "Order # and Description are required.", parent=dialog)
                return
            try:
                # Prefer PUT if your backend supports it, otherwise POST with id
                requests.put(f"{self.get_base()}/hotlist/{item_id}", json=updated, timeout=3)
                dialog.destroy()
                self.refresh()
            except Exception as e:
                # Fallback for backends that only have POST
                try:
                    updated["id"] = item_id
                    requests.post(f"{self.get_base()}/hotlist", json=updated, timeout=3)
                    dialog.destroy()
                    self.refresh()
                except Exception as e2:
                    messagebox.showerror("Error", str(e2), parent=dialog)

        tk.Button(dialog, text="Save", command=save, bg="#27ae60", fg="white", width=12).grid(
            row=5, column=0, columnspan=2, pady=15)

    def set_days(self, value):
        try:
            requests.post(f"{self.get_base()}/days", json={"days": value}, timeout=3)
            self.refresh()
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def set_custom_days(self):
        try:
            val = int(self.new_days.get())
            self.set_days(val)
        except ValueError:
            messagebox.showwarning("Invalid", "Enter a whole number.")

if __name__ == "__main__":
    app = ControlApp()
    app.mainloop()
