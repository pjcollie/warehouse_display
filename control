import tkinter as tk
from tkinter import ttk, messagebox
import requests

# Your Raspberry Pi IP
PI_IP = "10.50.154.254"

class ControlApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Warehouse Control")
        self.geometry("780x620")
        self.configure(bg="#f0f0f0")

        # Connection
        conn_frame = tk.Frame(self, bg="#f0f0f0")
        conn_frame.pack(fill="x", padx=15, pady=10)

        tk.Label(conn_frame, text="Pi IP:", bg="#f0f0f0").pack(side="left")
        self.ip_entry = tk.Entry(conn_frame, width=18)
        self.ip_entry.insert(0, PI_IP)
        self.ip_entry.pack(side="left", padx=5)
        tk.Button(conn_frame, text="Connect / Refresh", command=self.refresh).pack(side="left", padx=5)

        # Days section
        days_frame = tk.LabelFrame(self, text="Days Without a Mistake", padx=10, pady=10)
        days_frame.pack(fill="x", padx=15, pady=5)

        self.days_var = tk.StringVar(value="0")
        tk.Label(days_frame, textvariable=self.days_var, font=("Segoe UI", 24, "bold")).pack(side="left")

        tk.Button(days_frame, text="Set to 0", command=lambda: self.set_days(0)).pack(side="right", padx=5)
        self.new_days = tk.Entry(days_frame, width=6)
        self.new_days.pack(side="right")
        tk.Button(days_frame, text="Set Value", command=self.set_custom_days).pack(side="right", padx=5)

        # Add new item
        add_frame = tk.LabelFrame(self, text="Add Hot List Item", padx=10, pady=10)
        add_frame.pack(fill="x", padx=15, pady=5)

        form = tk.Frame(add_frame)
        form.pack(fill="x")

        tk.Label(form, text="Order #").grid(row=0, column=0, sticky="w")
        self.order_entry = tk.Entry(form, width=12)
        self.order_entry.grid(row=0, column=1, padx=5, pady=2)

        tk.Label(form, text="Location").grid(row=0, column=2, sticky="w")
        self.loc_entry = tk.Entry(form, width=12)
        self.loc_entry.grid(row=0, column=3, padx=5, pady=2)

        tk.Label(form, text="Priority").grid(row=0, column=4, sticky="w")
        self.priority = ttk.Combobox(form, values=["Critical", "High", "Medium", "Normal"], width=10, state="readonly")
        self.priority.set("Normal")
        self.priority.grid(row=0, column=5, padx=5, pady=2)

        tk.Label(form, text="Description").grid(row=1, column=0, sticky="w", pady=(6,0))
        self.desc_entry = tk.Entry(form, width=70)
        self.desc_entry.grid(row=1, column=1, columnspan=5, sticky="ew", padx=5, pady=(6,0))

        tk.Button(add_frame, text="Add to Hot List", command=self.add_item, bg="#27ae60", fg="white").pack(pady=8)

        # Current list
        list_frame = tk.LabelFrame(self, text="Current Hot List", padx=10, pady=10)
        list_frame.pack(fill="both", expand=True, padx=15, pady=5)

        self.tree = ttk.Treeview(list_frame, columns=("order", "desc", "loc", "pri"), show="headings", height=12)
        self.tree.heading("order", text="Order #")
        self.tree.heading("desc", text="Description")
        self.tree.heading("loc", text="Location")
        self.tree.heading("pri", text="Priority")
        self.tree.column("order", width=90)
        self.tree.column("desc", width=340)
        self.tree.column("loc", width=100)
        self.tree.column("pri", width=90)
        self.tree.pack(side="left", fill="both", expand=True)

        scrollbar = ttk.Scrollbar(list_frame, orient="vertical", command=self.tree.yview)
        scrollbar.pack(side="right", fill="y")
        self.tree.configure(yscrollcommand=scrollbar.set)

        tk.Button(self, text="Delete Selected", command=self.delete_item, bg="#c0392b", fg="white").pack(pady=8)

        self.refresh()

    def get_base(self):
        ip = self.ip_entry.get().strip()
        return f"http://{ip}:5000"

    def refresh(self):
        try:
            r = requests.get(f"{self.get_base()}/data", timeout=3)
            data = r.json()
            self.days_var.set(str(data.get("days_without_mistake", 0)))

            for row in self.tree.get_children():
                self.tree.delete(row)

            for item in data.get("hot_list", []):
                self.tree.insert("", "end", iid=item["id"], values=(
                    item.get("order_number", ""),
                    item.get("description", ""),
                    item.get("location", ""),
                    item.get("priority", "")
                ))
        except Exception as e:
            messagebox.showerror("Connection Error", f"Could not reach Pi.\n{e}")

    def add_item(self):
        item = {
            "order_number": self.order_entry.get().strip(),
            "description": self.desc_entry.get().strip(),
            "location": self.loc_entry.get().strip(),
            "priority": self.priority.get()
        }
        if not item["order_number"] or not item["description"]:
            messagebox.showwarning("Missing Info", "Order # and Description are required.")
            return
        try:
            requests.post(f"{self.get_base()}/hotlist", json=item, timeout=3)
            self.order_entry.delete(0, tk.END)
            self.desc_entry.delete(0, tk.END)
            self.loc_entry.delete(0, tk.END)
            self.refresh()
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def delete_item(self):
        selected = self.tree.selection()
        if not selected:
            return
        item_id = selected[0]
        try:
            requests.delete(f"{self.get_base()}/hotlist/{item_id}", timeout=3)
            self.refresh()
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def set_days(self, value):
        try:
            requests.post(f"{self.get_base()}/days", json={"days": value}, timeout=3)
            self.refresh()
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def set_custom_days(self):
        try:
            val = int(self.new_days.get())
            self.set_days(val)
        except ValueError:
            messagebox.showwarning("Invalid", "Enter a whole number.")

if __name__ == "__main__":
    app = ControlApp()
    app.mainloop()
